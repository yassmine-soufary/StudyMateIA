# Clé API xAI / Grok (ou compatible OpenAI)
XAI_API_KEY=XM6PtdotNvZkSMeqTKV47Qf5HsZ7bSAGKHTe6kVjitexpbwZeJZ2nVt0fhv34bgQCYGoRQ65Vszxq5eN

# Modèle Grok à utiliser (ex: grok-4, grok-beta, grok-2, etc.)
